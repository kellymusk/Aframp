{
  "name": "aframp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "dev": "next dev -p 3001",
    "lint": "eslint . --max-warnings 0",
    "start": "next start -p 3001",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:diff-coverage": "node scripts/check-diff-coverage.js",
    "check:env-docs": "node scripts/check-env-docs.js",
    "docs:env": "node scripts/check-env-docs.js --write",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:ts7": "npx -p typescript-7 tsc --noEmit",
    "prepare": "husky install || true",
    "lighthouse": "lhci autorun",
    "security:audit": "npm audit --audit-level=high",
    "security:owasp": "bash scripts/owasp-scan.sh",
    "security:all": "npm run security:audit && npm run security:owasp",
    "lint:deadcode": "knip"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@sentry/nextjs": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-qr-code": "^2.0.18",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "^16.4.2",
    "@next/eslint-plugin-next": "^16.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.42.1",
    "postcss": "^8.5",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.1.9",
    "ts-jest": "^29.4.6",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "typescript-7": "npm:typescript@^7.0",
    "typescript-eslint": "^8.67.0",
    "undici": "^8.3.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    },
    "braces": "^3.0.3",
    "sprintf-js": "^1.1.3"
  }
}
