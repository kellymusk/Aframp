# Aframp Pay — merchant frontend
#
# The browser talks to this app's own `/backend/*` rewrite (see
# next.config.mjs), which forwards server-side to the URL below — the real
# backend origin never reaches client-side code. Deliberately not
# NEXT_PUBLIC_*: that prefix would inline it into the browser bundle.

# Backend base URL — required, no default. Set it in .env.local to wherever
# your backend runs (your own local backend, or a deployed one). Keep the real
# value out of the repository.
#
# FORMAT: an http:// or https:// URL, e.g. https://api.example.com (a bare
# host is treated as https). The value is validated at build time
# (next.config.mjs): a malformed value or a non-HTTP(S) scheme fails the
# build. Left unset, /backend/* isn't proxied anywhere and every API call
# fails; a Vercel production build refuses to run without it.
#
# PORT CONSTRAINT: because the backend binds port 3000, this frontend must
# run on a different port (3001). The backend's CORS_ALLOWED_ORIGINS defaults
# to http://localhost:3001, so starting the app on Next.js's default port 3000
# causes silent CORS failures where every API call fails. Run the frontend on
# 3001 (e.g. `next dev -p 3001`) or update the backend's CORS_ALLOWED_ORIGINS
# to match the port you use.
# @type string (URL)
# @required
# @example https://api.example.com
NEXT_API_URL=

# Stellar network the app targets. Accepted values (case-sensitive):
#   TESTNET - local development and CI
#   MAINNET - production
# Set it explicitly: when unset, wallet-info.tsx falls back to testnet while
# use-stellar-status.ts falls back to mainnet.
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Demo mode: set to "true" to run the frontend against a Mock Service Worker
# instead of a real backend — no Rust backend needed. See "Demo mode" in the
# README. Leave unset (or anything other than "true") for normal development
# against a real backend.
# NEXT_PUBLIC_DEMO_MODE=true

# Stellar network used to build transaction receipt links on the Transactions
# page (stellar.expert/explorer/<network>/tx/<hash>). Must match whichever
# Horizon the backend is pointed at, or receipt links will 404.
#
# Accepted values: testnet | public.
# @type string (enum: testnet | public)
# @optional
# @default testnet
# @example testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Error reporting (Sentry). Leave every variable below unset to disable it —
# the app runs fine with no Sentry configuration at all.

# DSN used by the browser bundle. Exposed to the client (NEXT_PUBLIC_*).
# @type string (Sentry DSN URL)
# @optional
# @default (unset — client-side error reporting disabled)
# @example https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=

# DSN used by the server/edge runtime. Falls back to NEXT_PUBLIC_SENTRY_DSN
# when unset, so this is only needed if the server should report to a
# different Sentry project than the client.
# @type string (Sentry DSN URL)
# @optional
# @default (falls back to NEXT_PUBLIC_SENTRY_DSN, then disabled)
# @example https://examplePrivateKey@o0.ingest.sentry.io/1
# SENTRY_DSN=

# Auth token used only at build time to upload source maps to Sentry. Never
# required for `npm run dev`.
# @type string (Sentry auth token)
# @optional
# @default (unset — source map upload skipped)
# @example sntrys_eyJpYXQiOjE3MDAwMDAwMDAuMCwidXJsIjoiaHR0cHM6Ly9zZW50cnkuaW8ifQ==
# SENTRY_AUTH_TOKEN=

# Sentry organization slug, used at build time alongside SENTRY_AUTH_TOKEN.
# @type string
# @optional
# @default (unset — source map upload skipped)
# @example aframp
# SENTRY_ORG=

# Sentry project slug, used at build time alongside SENTRY_AUTH_TOKEN.
# @type string
# @optional
# @default (unset — source map upload skipped)
# @example aframp-pay
# SENTRY_PROJECT=

# Paystack Configuration (Nigeria - NGN)
# PAYSTACK_SECRET_KEY=sk_test_...

# Feature flag: show the ZAR on-ramp (Ozow) "Add funds" section on the Wallet page.
# Set to "true" to enable; omitted/false hides it.
# NEXT_PUBLIC_ZAR_ONRAMP_ENABLED=true

# Ozow Configuration (South Africa - ZAR)
# Instant EFT payment provider for South African Rand
# Get credentials from https://ozow.com
OZOW_API_KEY=your_api_key_here
OZOW_PRIVATE_KEY=your_private_key_here
OZOW_SITE_CODE=your_site_code_here
OZOW_IS_TEST=true
OZOW_WEBHOOK_URL=https://api.aframp.com/webhooks/ozow

