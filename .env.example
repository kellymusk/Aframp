# Aframp Pay — merchant frontend
#
# The browser talks to this app's own `/backend/*` rewrite (see
# next.config.mjs), which forwards server-side to the URL below — the real
# backend origin never reaches client-side code. Deliberately not
# NEXT_PUBLIC_*: that prefix would inline it into the browser bundle.

# Backend base URL. The backend binds 127.0.0.1:3000 by default.
# Must be an absolute http:// or https:// URL, e.g. http://127.0.0.1:3000 or https://api.example.com.
# Invalid values (relative paths, data: URIs, etc.) will cause startup to fail.
NEXT_API_URL=http://127.0.0.1:3000

# Optional: error reporting. Leave unset to disable.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Ozow Configuration (South Africa - ZAR)
# Instant EFT payment provider for South African Rand
# Get credentials from https://ozow.com
OZOW_API_KEY=your_api_key_here
OZOW_PRIVATE_KEY=your_private_key_here
OZOW_SITE_CODE=your_site_code_here
OZOW_IS_TEST=true
OZOW_WEBHOOK_URL=https://api.aframp.com/webhooks/ozow

# Web Push Notifications (optional)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# @type string
# @optional true
# @default ""
# @example BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcx...
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Stellar Network Configuration
# @type string
# @optional false
# @default testnet
# @example testnet|public
NEXT_PUBLIC_STELLAR_NETWORK=testnet
