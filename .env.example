# Aframp Pay — merchant frontend
#
# The browser calls the Rust backend directly, so this must be reachable from
# the customer's device, not just from the server. There is no API layer in
# this app.
#
# Every variable below is documented with a fixed set of tags so tooling can
# read them:
#   @type      the kind of value expected
#   @required  or @optional
#   @default   the value used when unset (optional vars only)
#   @example   a realistic example value
#
# `npm run check:env-docs` validates that every variable here carries these
# tags, and that the README's Environment Variables table (between the
# <!-- ENV_VARS_TABLE:START/END --> markers) matches this file. CI runs this
# check on every PR. After editing this file, run `npm run docs:env` to
# regenerate that table instead of hand-editing it.

# Backend base URL. The backend binds 127.0.0.1:3000 by default.
#
# This app runs on port 3001 (see the `dev` script) for two reasons: 3000 is
# taken by the backend, and the backend's CORS_ALLOWED_ORIGINS defaults to
# http://localhost:3001. Serve this on any other port and every request fails
# preflight until that origin is added to CORS_ALLOWED_ORIGINS server-side.
# @type string (URL)
# @required
# @example http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000

# Stellar network used to build transaction receipt links on the Transactions
# page (stellar.expert/explorer/<network>/tx/<hash>). Must match whichever
# Horizon the backend is pointed at, or receipt links will 404.
#
# Accepted values: testnet | public.
# @type string (enum: testnet | public)
# @optional
# @default testnet
# @example testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Error reporting (Sentry). Leave every variable below unset to disable it —
# the app runs fine with no Sentry configuration at all.

# DSN used by the browser bundle. Exposed to the client (NEXT_PUBLIC_*).
# @type string (Sentry DSN URL)
# @optional
# @default (unset — client-side error reporting disabled)
# @example https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=

# DSN used by the server/edge runtime. Falls back to NEXT_PUBLIC_SENTRY_DSN
# when unset, so this is only needed if the server should report to a
# different Sentry project than the client.
# @type string (Sentry DSN URL)
# @optional
# @default (falls back to NEXT_PUBLIC_SENTRY_DSN, then disabled)
# @example https://examplePrivateKey@o0.ingest.sentry.io/1
# SENTRY_DSN=

# Auth token used only at build time to upload source maps to Sentry. Never
# required for `npm run dev`.
# @type string (Sentry auth token)
# @optional
# @default (unset — source map upload skipped)
# @example sntrys_eyJpYXQiOjE3MDAwMDAwMDAuMCwidXJsIjoiaHR0cHM6Ly9zZW50cnkuaW8ifQ==
# SENTRY_AUTH_TOKEN=

# Sentry organization slug, used at build time alongside SENTRY_AUTH_TOKEN.
# @type string
# @optional
# @default (unset — source map upload skipped)
# @example aframp
# SENTRY_ORG=

# Sentry project slug, used at build time alongside SENTRY_AUTH_TOKEN.
# @type string
# @optional
# @default (unset — source map upload skipped)
# @example aframp-pay
# SENTRY_PROJECT=

# Payment providers for the onramp flow. Each is a public/publishable key,
# safe to expose to the client. Leave a provider's key unset to hide it from
# the onramp provider selector.
# @type string (Paystack public key)
# @optional
# @default (unset — Paystack hidden from the onramp provider selector)
# @example pk_test_examplekey1234567890
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# @type string (Flutterwave public key)
# @optional
# @default (unset — Flutterwave hidden from the onramp provider selector)
# @example FLWPUBK_TEST-1234567890abcdef1234567890abcdef-X
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Optional: cNGN issuer address on Stellar. Leave unset to keep cNGN charges
# disabled ("Coming soon") on the charge screen — the backend needs a
# matching issuer configured to produce a valid SEP-7 URI for cNGN.
# @type string (Stellar account address, G...)
# @optional
# @default (unset — cNGN charges disabled, shown as "Coming soon")
# @example GCNGNEXAMPLE234567890234567890234567890234567890234
# NEXT_PUBLIC_CNGN_ISSUER=
